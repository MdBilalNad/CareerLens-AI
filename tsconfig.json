{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "allowJs": true,
    "skipLibCheck": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowImportingTsExtensions": true,
    "noEmit": true,

    "jsx": "react-jsx",

    "isolatedModules": true,
    "moduleDetection": "force",

    "experimentalDecorators": true,

    "types": [
      "vite/client"
    ],

    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },

  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}